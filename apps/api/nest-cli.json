  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "plugins": ["@nestjs/swagger/plugin"],
    "builder": {
      "type": "rspack",
      "options": {
        "configPath": "rspack.config.cjs"
      }
    }
  }
}
