{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "META_GRAPH_API_VERSION",
    "WHATSAPP_API_VERSION",
    "META_GRAPH_BASE_URL",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_REDIRECT_URI",
    "CREDENTIAL_ENCRYPTION_KEY",
    "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
    "WHATSAPP_APP_SECRET"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {},
    "test": {},
    "test:e2e": {}
  }
}
