// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String?
  password            String
  refreshTokenHash    String? // TODO: fix multiple sessions
  systemRole          SystemRole           @default(USER)
  workspaceMembers    WorkspaceMember[]
  workspaceInvites    WorkspaceInvite[]    @relation("InviteCreator")
  whatsappOAuthStates WhatsAppOAuthState[]
}

model Workspace {
  id                  String               @id @default(uuid())
  name                String               @default("Main Workspace")
  workspaceMembers    WorkspaceMember[]
  workspaceInvites    WorkspaceInvite[]
  roles               Role[]
  permissions         Permission[]
  contacts            Contact[]
  whatsappConnection  WhatsAppConnection?
  whatsappOAuthStates WhatsAppOAuthState[]
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId      String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  workspaceId String

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
}

model WorkspaceInvite {
  id        String    @id @default(uuid())
  token     String    @unique
  email     String
  role      Role      @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  createdBy   User   @relation("InviteCreator", fields: [createdById], references: [id], onUpdate: Cascade, onDelete: Cascade)
  createdById String

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  workspaceId String
  roleId      String

  @@index([workspaceId])
}

enum RoleEnum {
  ADMIN
  MANAGER
  AGENT
}

enum SystemRole {
  USER
  ADMIN
}

model Role {
  id          String   @id @default(cuid())
  name        RoleEnum
  description String?

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  permissions      RolePermission[]
  members          WorkspaceMember[]
  workspaceInvites WorkspaceInvite[]

  @@unique([workspaceId, name])
}

model Permission {
  id          String           @id @default(uuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

enum WhatsAppConnectionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model WhatsAppConnection {
  id                        String                   @id @default(uuid())
  workspaceId               String                   @unique
  workspace                 Workspace                @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  metaUserId                String?
  metaBusinessAccountId     String
  whatsappBusinessAccountId String
  phoneNumberId             String
  displayPhoneNumber        String?
  verifiedName              String?
  businessName              String?
  encryptedAccessToken      String
  accessTokenExpiresAt      DateTime?
  status                    WhatsAppConnectionStatus @default(ACTIVE)
  lastError                 String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([status])
}

model WhatsAppOAuthState {
  id          String    @id @default(uuid())
  stateHash   String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([expiresAt])
}

enum ContactState {
  NEW
  LEAD
  CUSTOMER
  VIP
  IMPORTANT
  FOLLOWUP
  INTERESTED
  INACTIVE
  PARTNER
}

model Contact {
  id           String        @id @default(uuid())
  name         String
  contactInfos ContactInfo[]
  state        ContactState  @default(NEW)
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workspaceId  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([workspaceId])
}

model ContactInfo {
  id        String   @id @default(uuid())
  identity  String // phone , email etc
  source    String // linkedin etc
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contactId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}
